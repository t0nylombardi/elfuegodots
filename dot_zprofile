export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
typeset -U path

if [[ $OSTYPE == darwin* ]]; then
  export LANG="${LANG:-en_US.UTF-8}"
  export HOMEBREW_AUTO_UPDATE_SECS=804800

  path=(
    /Applications/Postgres.app/Contents/MacOS/bin
    /Applications/Postgres.app/Contents/Versions/latest/bin
    /usr/local/opt/llvm/bin
    /usr/local/opt/rustup/bin
    /opt/X11/bin
    /opt/metasploit-framework/bin
    "$HOME/.sketchybar/bin"
    "$path[@]"
  )

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    export CFLAGS="-I/opt/homebrew/include"
    export LDFLAGS="-L/opt/homebrew/lib"
    export CPPFLAGS="-I/opt/homebrew/include"
    export PKG_CONFIG_PATH="/opt/homebrew/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export RUBY_CONFIGURE_OPTS="--with-openssl-dir=/opt/homebrew/opt/openssl@3 --with-readline-dir=/opt/homebrew/opt/readline --enable-shared"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
else
  export LANG="${LANG:-C.UTF-8}"
fi

export BUN_INSTALL="${BUN_INSTALL:-$HOME/.bun}"
path=("$HOME/bin" "$HOME/.local/bin" "$BUN_INSTALL/bin" "$HOME/go/bin" "$HOME/.cargo/bin" "$path[@]")

if [[ -z ${EDITOR:-} ]]; then
  if [[ -z ${SSH_CONNECTION:-} ]] && command -v codium &>/dev/null; then
    export EDITOR="codium --wait"
  elif command -v nvim &>/dev/null; then
    export EDITOR=nvim
  else
    export EDITOR=vi
  fi
fi
export VISUAL="${VISUAL:-$EDITOR}"

if command -v pyenv &>/dev/null; then
  export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
  export PIPENV_VENV_IN_PROJECT=1
  eval "$(pyenv init --path)"
fi

if command -v rbenv &>/dev/null; then
  unset RBENV_VERSION
  eval "$(rbenv init - --no-rehash zsh)"
fi
